# Ejemplo de variables para aplicaciones (fase H0-B en adelante).
# Copiar a .env en la raíz o en apps/* según se documente en H0-B.
# NUNCA commitear .env con valores reales.

# --- API (ficticio) ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# URI de MongoDB: usuario de aplicación gym_erp_app (operativo en desarrollo local;
# no usar root). Sustituir CHANGE_ME por la contraseña real solo en .env local.
# Ver infra/compose/README.md
MONGODB_URI=mongodb://gym_erp_app:CHANGE_ME@127.0.0.1:27017/gym_operational?replicaSet=rs0&authSource=admin
# Bases lógicas (ADR-0008); un solo AsyncMongoClient. Nombres no secretos.
MONGODB_PLATFORM_DB=gym_platform
MONGODB_OPERATIONAL_DB=gym_operational
# Referencia documental legacy; la API usa MONGODB_OPERATIONAL_DB para operational.
MONGODB_DB_NAME=gym_operational
MONGODB_PING_TIMEOUT_MS=2000

# Variables solo para Docker Compose local (infra/compose/.env — NO commitear):
# MONGO_ROOT_USERNAME=...
# MONGO_ROOT_PASSWORD=...

# Reservado para ADR-0003 (Proposed — autenticación NO aprobada aún). No usar en H0-B.
# JWT_SIGNING_SECRET=CHANGE_ME_WHEN_ADR_0003_ACCEPTED

# CORS: origen del ERP web en desarrollo
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- ERP Web (prefijo VITE_ es público en el cliente) ---
# Desarrollo con Vite: dejar vacío o usar /api/v1 (proxy en vite.config.js → :8000).
# VITE_API_BASE_URL=/api/v1
# Solo si el navegador llama directo al API (requiere CORS + expose X-CSRF-Token):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
